# ============================================================================
# THE OPEN ONE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure local values.
# NEVER commit real passwords or production secrets to version control.
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# MySQL Database Configuration (Local Development)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=the_open_one
DB_CONNECTION_LIMIT=10

# Railway Production Deployment Note:
# Railway's MySQL plugin creates a dedicated database (typically named 'railway') and exposes
# standard environment variables. You can either:
# 1. Reference Railway template variables in your Railway service environment settings:
#    DB_HOST=${{MySQL.MYSQLHOST}}
#    DB_PORT=${{MySQL.MYSQLPORT}}
#    DB_USER=${{MySQL.MYSQLUSER}}
#    DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
#    DB_NAME=${{MySQL.MYSQLDATABASE}}
#    (IMPORTANT: DB_NAME must match the actual database provisioned on Railway, e.g. 'railway', not 'the_open_one')
# 2. Or let the backend auto-detect Railway's standard variables directly:
#    MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE, or MYSQL_URL / DATABASE_URL.
# In production (NODE_ENV=production), the server will NOT silently fall back to localhost or the_open_one.

# Phase 2 Authentication & Security Placeholders
# JWT_SECRET: Strong random secret string used to sign backend customer session tokens.
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# GOOGLE_CLIENT_ID: The OAuth 2.0 Web Client ID from Google Cloud Console.
# Used by the backend to verify the audience ('aud') of Google ID tokens.
GOOGLE_CLIENT_ID=your_google_client_id_here
# VITE_GOOGLE_CLIENT_ID: Frontend Google Web Client ID for Google Identity Services (GIS).
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Existing AI Studio Environment Settings
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Phase 2 Admin Seeder (Manual one-off CLI script: npm run seed:admin)
# IMPORTANT: Unset or remove ADMIN_INITIAL_PASSWORD from environment after seeding.
ADMIN_INITIAL_NAME=Admin
ADMIN_INITIAL_EMAIL=admin@theopenone.com
ADMIN_INITIAL_PASSWORD=your_secure_admin_password_here

# Email Delivery Configuration (Resend REST API via HTTPS)
# Railway blocks outbound SMTP (ports 25/465/587/2525) on Free/Trial/Hobby plans,
# so emails are delivered via Resend's HTTPS API (POST https://api.resend.com/emails).
#
# RESEND_API_KEY: Your Resend API key (starts with "re_...").
# Get an API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# CONTACT_FROM_EMAIL: The display "from" address for all outbound emails.
# Default: "THE OPEN ONE <onboarding@resend.dev>"
# IMPORTANT (Resend Sending Restrictions):
# - DO NOT set CONTACT_FROM_EMAIL to a @gmail.com address! Resend strictly rejects @gmail.com with HTTP 403
#   because public webmail domains cannot be verified on Resend.
# - On the free Resend sandbox, the sender MUST be onboarding@resend.dev (or "THE OPEN ONE <onboarding@resend.dev>"),
#   and emails can ONLY be delivered to the verified Resend account owner's email address (ADMIN_NOTIFY_EMAIL).
# - Customer-facing emails (to arbitrary recipient addresses) cannot be delivered until you verify
#   a custom domain in Resend.
# - Once a custom domain is verified on https://resend.com/domains (e.g. yourdomain.com), update this to:
#   CONTACT_FROM_EMAIL="THE OPEN ONE <orders@yourdomain.com>"
CONTACT_FROM_EMAIL="THE OPEN ONE <onboarding@resend.dev>"

# ADMIN_NOTIFY_EMAIL: Official restaurant inbox / Resend account owner email address.
# In Resend sandbox mode, this is the only recipient address Resend allows.
ADMIN_NOTIFY_EMAIL=officialtheopenone@gmail.com

# ============================================================================
# Cashfree Payment Gateway Configuration
# ============================================================================
# CASHFREE_ENV: Target environment ('sandbox' | 'production'). Defaults to 'sandbox' if unset.
# VITE_CASHFREE_MODE: Frontend SDK mode ('sandbox' | 'production'). Defaults to 'sandbox' if unset.
#
# CRITICAL NOTICE:
# CASHFREE_ENV and VITE_CASHFREE_MODE must be set together and MUST match!
# If one is set to 'production' and the other to 'sandbox', customer checkout will fail
# with a session-not-found error because the frontend SDK and backend API will target
# different Cashfree gateway environments.
#
CASHFREE_ENV=sandbox
VITE_CASHFREE_MODE=sandbox
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_API_VERSION=2023-08-01

# CASHFREE_BASE_URL: OPTIONAL override. By default, baseUrl is derived from CASHFREE_ENV:
# - 'sandbox'    -> https://sandbox.cashfree.com/pg
# - 'production' -> https://api.cashfree.com/pg
# Only set this if you need a custom proxy or explicit URL override.
# CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg

# CASHFREE_RETURN_URL: Customer redirect destination after checkout completes.
# Uses {order_id} template token. Defaults to https://the-open-one.vercel.app/checkout/confirmation?order_id={order_id}
CASHFREE_RETURN_URL=https://the-open-one.vercel.app/checkout/confirmation?order_id={order_id}

# CASHFREE_NOTIFY_URL: Server-to-server webhook destination registered with Cashfree.
# Defaults to https://the-open-one-production.up.railway.app/api/payments/cashfree/webhook
CASHFREE_NOTIFY_URL=https://the-open-one-production.up.railway.app/api/payments/cashfree/webhook


